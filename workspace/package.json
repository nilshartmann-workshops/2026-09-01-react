{
  "name": "react-training-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "backend": "cd ../backend && npm start",
    "dev": "vite --port 3000",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write .",
    "check": "npm run prettier:check && npm run lint && tsc -b --noEmit",
    "check:fix": "npm run prettier:write && npm run lint:fix",
    "check:ts": "tsc -b --noEmit",
    "graphql:codegen": "graphql-codegen",
    "graphql:codegen:watch": "graphql-codegen -w"
  },
  "dependencies": {
    "@apollo/client": "^4.2.10",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@tailwindcss/vite": "^4.1.10",
    "@tanstack/react-form": "^1.33.3",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "graphql": "^16.14.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-error-boundary": "^6.0.0",
    "rxjs": "^7.8.2",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.10",
    "zod": "^4.0.17",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@graphql-codegen/cli": "^7.2.0",
    "@graphql-codegen/typed-document-node": "^7.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.5",
    "@parcel/watcher": "^2.6.0",
    "@tanstack/react-devtools": "^0.10.12",
    "@tanstack/react-form-devtools": "^0.2.34",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
